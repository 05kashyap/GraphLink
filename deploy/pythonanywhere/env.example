# Copy to ~/graphlink-data/env on PythonAnywhere and fill in the blanks.
# Both the web app (via the WSGI file) and deploy.sh read this file.
# Replace kashyap05 with your PythonAnywhere username if it differs.

DJANGO_DEBUG=False
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=kashyap05.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://kashyap05.pythonanywhere.com

# Live data lives outside the repository so deploys never overwrite it.
DJANGO_DB_PATH=/home/kashyap05/graphlink-data/db.sqlite3
DJANGO_MEDIA_ROOT=/home/kashyap05/graphlink-data/media

# Optional: Gmail address and app password for password reset emails.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
